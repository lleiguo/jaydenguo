#!/bin/sh
# Runs before every push (intent 0010, GH-2, GH-3). Installed by
# `pnpm install` (the `prepare` script sets core.hooksPath).
# Agents never skip it with --no-verify (AGENTS.md, Workflow).

# GUI git clients may not have pnpm on PATH.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

zero=0000000000000000000000000000000000000000
pushes=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push to main. Open a PR and merge it when CI passes (AGENTS.md, Workflow)." >&2
    exit 1
  fi
  [ "$local_sha" != "$zero" ] && pushes=1
done

# Only deleting branches: nothing to check.
[ "$pushes" = 0 ] && exit 0

echo "pre-push: pnpm verify" >&2
pnpm verify || {
  echo "pre-push: pnpm verify failed; fix it before pushing." >&2
  exit 1
}
