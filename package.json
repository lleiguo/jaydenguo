{
  "name": "jaydenguo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/worker.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check:build": "node scripts/check-no-dev-login.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi --check && pnpm test",
    "verify:full": "pnpm verify && if [ -n \"$DATABASE_URL\" ]; then pnpm test:int; else echo 'DATABASE_URL not set: skipping test:int'; fi",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/worker/main.ts migrate",
    "job": "tsx src/worker/main.ts",
    "smoke": "tsx src/worker/main.ts smoke",
    "seed": "tsx src/worker/main.ts seed",
    "openapi": "tsx scripts/openapi.ts",
    "assistant:eval": "tsx scripts/assistant-eval.ts",
    "assistant:shared-eval": "tsx scripts/assistant-shared-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.11",
    "@fullcalendar/react": "^7.1.0",
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@google-cloud/kms": "^6.2.0",
    "@google-cloud/run": "^4.1.0",
    "@google/genai": "^2.24.0",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^10.5.0",
    "ical.js": "^2.2.1",
    "next": "16.3.8",
    "node-html-parser": "^9.0.4",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
