# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
APP_URL=http://localhost:3000

# Google sign-in with the local-dev OAuth client (redirect URI
# http://localhost:3000/auth/google/callback). Without these, use the
# dev-only shortcut: http://localhost:3000/auth/dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to the owner's account.
# ALLOWED_EMAILS=you@example.com
