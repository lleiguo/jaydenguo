<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app group holds the offline cache, the widgets' data and the shared
     device token (OFF-3, EXT-2, PUSH-2). Push (PUSH-6): archives for
     TestFlight switch to production. Keep HubApp-NoPush.entitlements in
     step. -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HUB_APP_GROUP)</string>
	</array>
</dict>
</plist>
